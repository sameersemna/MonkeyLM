# MonkeyLM environment configuration example.
# Copy this file to `.env` and adjust values for your environment.

# -----------------------------------------------------------------------------
# Target and model
# -----------------------------------------------------------------------------

# URL where the monkey test starts.
TARGET_URL=https://noblequran-85hu2yge.manus.space/

# Ollama model used for action planning.
# Use a local model name such as `llama3.2` for local inference,
# or keep the default cloud endpoint model if one is configured.
OLLAMA_MODEL=minimax-m3:cloud

# Hard timeout in seconds for each Ollama inference call.
OLLAMA_TIMEOUT_SECONDS=15

# Tip for high-concurrency runs: set these in the shell that starts Ollama:
#   OLLAMA_NUM_PARALLEL=4   (match or exceed WORKERS)
#   OLLAMA_KV_CACHE_TYPE=q4_0

# -----------------------------------------------------------------------------
# Concurrency and step budget
# -----------------------------------------------------------------------------

# Total number of monkey actions to execute across all workers.
MAX_STEPS=100

# Maximum number of concurrent worker browser contexts.
# Start with 1 and increase gradually after verifying stability.
WORKERS=1

# Per-worker step cap. Must be less than or equal to MAX_STEPS.
MAX_STEPS_PER_WORKER=100

# -----------------------------------------------------------------------------
# Browser behavior
# -----------------------------------------------------------------------------

# Run browser headless when true.
HEADLESS=true

# Browser launch size as WIDTH,HEIGHT or WIDTHxHEIGHT.
BROWSER_WINDOW_SIZE=1920,1080

# Use browser window size directly instead of Playwright viewport emulation.
NO_VIEWPORT=true

# -----------------------------------------------------------------------------
# Retry policy
# -----------------------------------------------------------------------------

# Retry count for initial worker navigation to the target URL.
WORKER_NAVIGATION_RETRIES=2

# Retry count for worker-level Qdrant initialization.
WORKER_QDRANT_INIT_RETRIES=1

# Retry count for out-of-scope boundary recovery navigation.
WORKER_BOUNDARY_RECOVERY_RETRIES=1

# Base backoff delay in seconds for worker retry operations (exponential with jitter).
# Must be greater than 0 and less than or equal to 10.
RETRY_BASE_DELAY_SECONDS=0.75

# -----------------------------------------------------------------------------
# Persistence services
# -----------------------------------------------------------------------------

# PostgreSQL connection string for baseline and drift logging.
POSTGRES_DSN=postgresql://localhost:5432/monkeylm

# Redis connection URL for visited-state tracking.
# Include the password in the URL when authentication is required:
#   redis://:password@latitude:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional prefix applied to all Redis keys (default: empty).
# Example: REDIS_PREFIX=monkey: makes visited-state keys "monkey:monkeylm:visited_states:<timestamp>".
REDIS_PREFIX=

# TTL in seconds for cross-worker action-path Redis locks.
# Workers claim a lock with key "{REDIS_PREFIX}monkeylm:active_path:<hash>" before
# performing a click/type/navigation so concurrent workers avoid duplicating the
# same UI path. Must be between 1 and 300 seconds.
REDIS_PATH_LOCK_TTL_SECONDS=45

# Fail startup if PostgreSQL or Redis is unreachable when true.
# When false, persistence failures are logged but the run continues.
STRICT_PERSISTENCE=false

# TTL in seconds for Redis visited-state keys.
REDIS_STATE_TTL_SECONDS=86400

# Golden baseline strategy: `preexisting` compares only against existing goldens,
# `auto_upsert` seeds a new golden when none exists.
GOLDEN_BASELINE_MODE=preexisting

# -----------------------------------------------------------------------------
# Qdrant semantic memory
# -----------------------------------------------------------------------------

# Qdrant base URL.
QDRANT_URL=http://127.0.0.1:6333

# Qdrant collection name for semantic memory logs.
QDRANT_COLLECTION=monkeylm_semantic_memory

# Vector size for Qdrant embeddings.
QDRANT_VECTOR_SIZE=256

# Embedding backend: `hash` (stable deterministic vectors) or `ollama`.
QDRANT_EMBEDDING_PROVIDER=hash

# Ollama embedding model name, used when provider is `ollama`.
QDRANT_EMBEDDING_MODEL=nomic-embed-text

# Enable second-stage reranking of Qdrant candidates via Ollama.
QDRANT_RERANK_ENABLED=false

# Ollama model used for reranking when enabled.
QDRANT_RERANK_MODEL=qwen2.5:3b

# Number of candidates to fetch from Qdrant before reranking.
QDRANT_CANDIDATE_LIMIT=20

# -----------------------------------------------------------------------------
# Browser sandbox policy
# -----------------------------------------------------------------------------

# Require Chromium sandbox launch; fail if sandbox is unavailable.
STRICT_SANDBOX=false

# Allow fallback to `--no-sandbox` when sandbox launch fails.
ALLOW_NO_SANDBOX_FALLBACK=false
